DJANGO_SECRET_KEY=replace-this-for-non-local-environments
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty for local SQLite development.
# For Supabase, paste the pooled PostgreSQL connection string from Project Settings > Database.
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres
DATABASE_URL=
# Use the standard PostgreSQL backend. Radius queries call PostGIS directly.
DB_ENGINE=django.db.backends.postgresql

# Redis broker for Celery background notifications and scheduled forecasts.
REDIS_URL=redis://127.0.0.1:6379/0

# Optional Firebase Cloud Messaging setup. Keep the service-account JSON out of source control.
FIREBASE_ENABLED=0
FIREBASE_CREDENTIALS_PATH=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=